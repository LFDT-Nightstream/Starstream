      Unify-Const: () ~ () => {}
  T-Fn: advance => ()
    T-Resume: {advance: fn() -> (), new: fn() -> (), step: fn() -> ()} ⊢ resume; ⇒ ()
      Unify-Const: () ~ () => {}
  T-Fn: helper => ()
