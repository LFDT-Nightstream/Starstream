utxo PayToPublicKey {
    storage {
        let mut _recipient: PublicKey;
    }

    main fn start(recipient: PublicKey) {
        _recipient = recipient;
        yield(IPayToPublicKey);
    }

    impl IPayToPublicKey {
        fn consume() {
            resume;
        }
    }
}
