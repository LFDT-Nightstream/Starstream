{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "prestart": "npm run build-vsix && npm run build-sandbox && npm run build-ledger",
    "start": "docusaurus start",
    "build": "npm run build-vsix && npm run build-sandbox && npm run build-ledger && docusaurus build",
    "build-vsix": "cd ../vscode-starstream && npm ci && npx vsce package -o starstream.vsix",
    "build-sandbox": "cargo build -p starstream-sandbox-web --target wasm32-unknown-unknown --release && wasm-opt -O3 ../target/wasm32-unknown-unknown/release/starstream_sandbox_web.wasm -o starstream_sandbox_web.wasm",
    "build-ledger": "cd ../starstream-js && npm ci && cd ../website && cargo build -p starstream-ledger-web -p starstream-ledger-client-web --target wasm32-unknown-unknown --release && wasm-opt -O3 ../target/wasm32-unknown-unknown/release/starstream_ledger_web.wasm -o starstream_ledger_web.wasm && wasm-opt -O3 ../target/wasm32-unknown-unknown/release/starstream_ledger_client_web.wasm -o starstream_ledger_client_web.wasm",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@codingame/monaco-vscode-configuration-service-override": "^22.1.9",
    "@codingame/monaco-vscode-editor-api": "^22.1.3",
    "@codingame/monaco-vscode-explorer-service-override": "^22.1.9",
    "@codingame/monaco-vscode-extension-api": "^22.1.3",
    "@codingame/monaco-vscode-files-service-override": "^22.1.9",
    "@codingame/monaco-vscode-markers-service-override": "^22.1.9",
    "@codingame/monaco-vscode-search-service-override": "^22.1.9",
    "@codingame/monaco-vscode-workbench-service-override": "^22.1.9",
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@mdx-js/react": "^3.0.0",
    "@typefox/monaco-editor-react": "7.2.0",
    "@zip.js/zip.js": "^2.8.8",
    "cbor2": "^2.0.1",
    "docusaurus-plugin-generate-llms-txt": "^0.0.1",
    "fancy-ansi": "^0.1.3",
    "ghostty-web": "^0.4.0",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@^22.1.3",
    "monaco-languageclient": "10.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "smol-toml": "^1.9.1",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@^22.1.3"
  },
  "overrides": {
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@^22.1.3"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@docusaurus/tsconfig": "^3.9.2",
    "@docusaurus/types": "^3.9.2",
    "file-loader": "^6.2.0",
    "typescript": "~5.9.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
