==== WIT ====
package root:component;

world root {
  import starstream:std/builtin;
  import starstream:std/utxo-context;
  import starstream:self/my-utxo;
  use starstream:std/builtin.{utxo as s-utxo, token as s-token};
  use starstream:std/utxo-context.{utxo-context as s-utxo-context};
  use starstream:self/my-utxo.{utxo as u-my-utxo};

  export my-utxo: interface {
    use starstream:std/utxo-context.{utxo-context as s-utxo-context};

    resource utxo {
      hello-utxo: static func(utxo-context: borrow<s-utxo-context>, x: s32) -> utxo;
      foo: func(utxo-context: borrow<s-utxo-context>);
    }

    record storage {
      yield: s32,
      yield1: s32,
      yield1-v1: s32,
      yield1-v2: s32,
    }

    get-storage: func(self: borrow<utxo>) -> storage;

    set-storage: func(storage: storage) -> utxo;
  }
}
package starstream:std {
  interface builtin {
    resource utxo;

    resource token;
  }
  interface utxo-context {
    resource utxo-context {
      resume: func();
      implements-method: func(hash: tuple<u64, u64, u64, u64>);
    }
  }
}


package starstream:self {
  interface my-utxo {
    resource utxo {
      hello-utxo: static func(x: s32) -> utxo;
      foo: func();
    }
  }
}
