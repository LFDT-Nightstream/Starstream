==== WIT ====
package root:component;

world root {
  import starstream:std/builtin;
  import starstream:std/utxo-context;
  import starstream:contract/dynamic-utxo;
  import starstream:self/require-hash-preimage;
  use starstream:std/builtin.{utxo as s-utxo, token as s-token};
  use starstream:std/utxo-context.{utxo-context as s-utxo-context};
  use starstream:self/require-hash-preimage.{utxo as u-require-hash-preimage};

  export create-hash: func(input: u64) -> u-require-hash-preimage;
  export consume-hash: func(utxo: borrow<u-require-hash-preimage>, input: u64);
  @external-id("starstream:test:Succeeds when matching")
  export test10: func();
  @external-id("starstream:test:Fails when not matching")
  export test11: func();
  @external-id("starstream:test:Alive UTXO")
  export test12: func();
  export require-hash-preimage: interface {
    use starstream:std/utxo-context.{utxo-context as s-utxo-context};

    resource utxo {
      create: static func(utxo-context: s-utxo-context, hash: u64) -> utxo;
      consume: func(preimage: u64);
    }

    record storage {
      yield: s32,
      hash: s64,
      yield1: s32,
      yield1-v1: s64,
      yield1-v2: s32,
    }

    get-storage: func(self: borrow<utxo>) -> storage;

    set-storage: func(ctx: s-utxo-context, storage: storage) -> utxo;
  }
  export sha256-u64: func(input: u64) -> u64;
}
package starstream:std {
  interface builtin {
    resource utxo {
      has-method: func(hash: tuple<u64, u64, u64, u64>) -> bool;
    }

    resource token;
  }
  interface utxo-context {
    resource utxo-context {
      resume: func();
      implements-method: func(hash: tuple<u64, u64, u64, u64>);
    }
  }
}


package starstream:contract {
  interface dynamic-utxo {
    use starstream:std/builtin.{utxo as s-utxo};

    consume: func(self: borrow<s-utxo>, preimage: u64);
  }
}


package starstream:self {
  interface require-hash-preimage {
    resource utxo {
      create: static func(hash: u64) -> utxo;
      consume: func(preimage: u64);
    }
  }
}

==== Test: Succeeds when matching ====
events: []
outputs: [
    Ok(
        UtxoCtx {
            methods: [],
            dropped: true,
        },
    ),
]

==== Test: Fails when not matching ====
panic: call_coordination_script: failed to call function

Caused by:
    0: failed to call function
    1: error while executing at wasm backtrace:
    0:    0x75f - <unknown>!<wasm function 16>
    1:    0x7e8 - <unknown>!<wasm function 21>
    2:    0x81f - <unknown>!<wasm function 24>
    2: wasm trap: wasm `unreachable` instruction executed

==== Test: Alive UTXO ====
events: []
outputs: [
    Ok(
        UtxoCtx {
            methods: [
                (
                    10270437411857036182,
                    11521531740810906571,
                    17538181920428761180,
                    16061404310442802309,
                ),
            ],
            dropped: false,
        },
    ),
]
