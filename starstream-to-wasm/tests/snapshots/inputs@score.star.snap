==== WIT ====
package root:component;

world root {
  import starstream:std/builtin;
  import starstream:std/utxo-context;
  import starstream:events/score;
  import starstream:self/score-progress;
  use starstream:std/builtin.{utxo as s-utxo, token as s-token};
  use starstream:std/utxo-context.{utxo-context as s-utxo-context};
  use starstream:self/score-progress.{utxo as u-score-progress};

  export example: func();
  export score-progress: interface {
    use starstream:std/builtin.{utxo as s-utxo, token as s-token};
    use starstream:std/utxo-context.{utxo-context as s-utxo-context};

    resource utxo {
      new: static func() -> utxo;
      plus-chips: func(chips2: u64);
      plus-mult: func(mult2: u64);
      mult-mult: func(mult-pct: u64);
      finish: func();
    }

    record storage {
      yield: s32,
      chips: s64,
      mult: s64,
      yield1: s32,
    }

    get-storage: func(self: borrow<utxo>) -> storage;

    set-storage: func(storage: storage) -> utxo;
  }
}
package starstream:std {
  interface builtin {
    resource utxo;

    resource token;
  }
  interface utxo-context {
    resource utxo-context {
      implements-method: func(hash: tuple<u64, u64, u64, u64>);
    }
  }
}


package starstream:events {
  interface score {
    finish: func(total: u64);
  }
}


package starstream:self {
  interface score-progress {
    resource utxo {
      new: static func() -> utxo;
      plus-chips: func(chips2: u64);
      plus-mult: func(mult2: u64);
      mult-mult: func(mult-pct: u64);
      finish: func();
    }
  }
}
