==== WIT ====
package root:component;

world root {
  import starstream:std/builtin;
  import starstream:std/utxo-context;
  import starstream:events/my-token-events;
  import starstream:self/my-token;
  import starstream:self/holder;
  use starstream:std/builtin.{utxo as s-utxo, token as s-token};
  use starstream:std/utxo-context.{utxo-context as s-utxo-context};
  use starstream:self/my-token.{token as t-my-token};
  use starstream:self/holder.{utxo as u-holder};

  export move-token: func(source: borrow<s-utxo>, dest: borrow<s-utxo>);
  @external-id("starstream:test:Attach a token to concrete utxos")
  export test17: func();
  export my-token: interface {
    use starstream:std/builtin.{utxo as s-utxo};
    use starstream:std/utxo-context.{utxo-context as s-utxo-context};

    resource token {
      my-mint: static func() -> token;
      attach: func(to: borrow<s-utxo>);
      detach: func(source: borrow<s-utxo>);
    }

    record storage {
      attached: s64,
    }

    get-storage: func(self: borrow<token>) -> storage;

    set-storage: func(ctx: s-utxo-context, storage: storage) -> token;
  }
  export holder: interface {
    use starstream:std/utxo-context.{utxo-context as s-utxo-context};

    resource utxo {
      new: static func(utxo-context: s-utxo-context) -> utxo;
    }

    record storage {
      yield: s32,
      yield1: s32,
      yield1-v1: s32,
    }

    get-storage: func(self: borrow<utxo>) -> storage;

    set-storage: func(ctx: s-utxo-context, storage: storage) -> utxo;
  }
}
package starstream:std {
  interface builtin {
    resource utxo {
      has-method: func(hash: tuple<u64, u64, u64, u64>) -> bool;
    }

    resource token;

    push-effect-handler-frame: func(frame-id: u32);

    add-effect-handler: func(hash: tuple<u64, u64, u64, u64>);

    pop-effect-handler-frame: func();
  }
  interface utxo-context {
    resource utxo-context {
      resume: func();
      implements-method: func(hash: tuple<u64, u64, u64, u64>);
    }
  }
}


package starstream:events {
  interface my-token-events {
    attached: func(count: u64);

    detached: func(count: u64);
  }
}


package starstream:self {
  interface my-token {
    use starstream:std/builtin.{utxo as s-utxo};

    resource token {
      my-mint: static func() -> token;
      attach: func(to: borrow<s-utxo>);
      detach: func(source: borrow<s-utxo>);
    }
  }
  interface holder {
    use starstream:std/builtin.{utxo as s-utxo};

    resource utxo {
      new: static func() -> utxo;
    }

    upcast: func(self: borrow<utxo>) -> s-utxo;
  }
}

==== Test: Attach a token to concrete utxos ====
events: [
    Event {
        abi_name: "my-token-events",
        name: "attached",
        params: [
            U64(
                1,
            ),
        ],
    },
    Event {
        abi_name: "my-token-events",
        name: "detached",
        params: [
            U64(
                0,
            ),
        ],
    },
    Event {
        abi_name: "my-token-events",
        name: "attached",
        params: [
            U64(
                1,
            ),
        ],
    },
]
outputs: [
    Ok(
        UtxoCtx {
            methods: [],
            dropped: false,
        },
    ),
    Ok(
        UtxoCtx {
            methods: [],
            dropped: false,
        },
    ),
]
