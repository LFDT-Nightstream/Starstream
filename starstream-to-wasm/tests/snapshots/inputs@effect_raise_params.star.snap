==== WIT ====
package root:component;

world root {
  import starstream:std/builtin;
  import starstream:effects/foo;
  import starstream:events/foo;
  use starstream:std/builtin.{utxo as s-utxo, token as s-token};

  export main: func();
  @external-id("starstream:test:Test")
  export test4: func();
  @external-id("starstream:test:Unhandled")
  export test5: func();
  export assert-effect-not-handled: func(id: tuple<u64, u64, u64, u64>);
  export starstream:effect-handler/foo;
}
package starstream:std {
  interface builtin {
    resource utxo {
      has-method: func(hash: tuple<u64, u64, u64, u64>) -> bool;
    }

    resource token;
  }
}


package starstream:effects {
  interface foo {
    basic: func();

    complex: func(in: u32) -> u32;
  }
}


package starstream:events {
  interface foo {
    log: func(point: u32);
  }
}


package starstream:effect-handler {
  interface foo {
    basic: func() -> u8;

    complex: func(in: u32) -> tuple<u8, u32>;
  }
}

