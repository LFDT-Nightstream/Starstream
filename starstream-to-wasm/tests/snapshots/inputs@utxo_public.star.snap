==== WIT ====
package root:component;

world root {
  import starstream:std/builtin;
  import starstream:std/utxo-context;
  import starstream:contract/dynamic-utxo;
  import starstream:events/observations;
  import starstream:self/counter;
  use starstream:std/builtin.{utxo as s-utxo, token as s-token};
  use starstream:std/utxo-context.{utxo-context as s-utxo-context};
  use starstream:self/counter.{utxo as u-counter};

  @external-id("starstream:test:Public methods at an empty yield")
  export test15: func();
  @external-id("starstream:test:Public methods alongside an explicit ABI")
  export test16: func();
  @external-id("starstream:test:Storage updates and public resume across three yields")
  export test17: func();
  @external-id("starstream:test:Public methods in another constructor\u{27}s nested yield")
  export test18: func();
  @external-id("starstream:test:Constructor call chaining")
  export test19: func();
  export counter: interface {
    use starstream:std/utxo-context.{utxo-context as s-utxo-context};

    resource utxo {
      advance: func();
      new: static func(utxo-context: s-utxo-context) -> utxo;
      other: static func(utxo-context: s-utxo-context) -> utxo;
      add: func(x: s64) -> s64;
      extra: func();
    }

    record storage {
      yield: s32,
      count: s64,
      yield1: s32,
      yield1-v1: s32,
      yield2: s32,
      yield2-v1: s32,
      yield3: s32,
      yield3-v1: s32,
      yield4: s32,
      yield4-v1: s32,
      yield5: s32,
      yield5-v1: s32,
    }

    get-storage: func(self: borrow<utxo>) -> storage;

    set-storage: func(ctx: s-utxo-context, storage: storage) -> utxo;
  }
}
package starstream:std {
  interface builtin {
    resource utxo {
      has-method: func(hash: tuple<u64, u64, u64, u64>) -> bool;
    }

    resource token;
  }
  interface utxo-context {
    resource utxo-context {
      resume: func();
      implements-method: func(hash: tuple<u64, u64, u64, u64>);
    }
  }
}


package starstream:contract {
  interface dynamic-utxo {
    use starstream:std/builtin.{utxo as s-utxo};

    extra: func(self: borrow<s-utxo>);
  }
}


package starstream:events {
  interface observations {
    value: func(value: s64);
  }
}


package starstream:self {
  interface counter {
    resource utxo {
      advance: func();
      new: static func() -> utxo;
      other: static func() -> utxo;
      add: func(x: s64) -> s64;
    }
  }
}

==== Test: Public methods at an empty yield ====
events: [
    Event {
        abi_name: "observations",
        name: "value",
        params: [
            S64(
                15,
            ),
        ],
    },
]
outputs: [
    Ok(
        UtxoCtx {
            methods: [
                (
                    13454256118461042148,
                    15960079323170627318,
                    6169022919517591603,
                    9619313162469964915,
                ),
                (
                    18236801192180751998,
                    3273890352309065231,
                    3729828498835407705,
                    7442122955733531148,
                ),
            ],
            dropped: false,
        },
    ),
]

