==== WIT ====
package root:component;

world root {
  import starstream:std/builtin;
  import starstream:std/utxo-context;
  import starstream:contract/dynamic-utxo;
  import starstream:effects/effects;
  import starstream:events/effects;
  import starstream:self/trigger-utxo;
  use starstream:std/builtin.{utxo as s-utxo, token as s-token};
  use starstream:std/utxo-context.{utxo-context as s-utxo-context};
  use starstream:self/trigger-utxo.{utxo as u-trigger-utxo};

  export main: func();
  @external-id("starstream:test:Effect search reaches outer instance handler")
  export test9: func();
  export trigger-utxo: interface {
    use starstream:std/utxo-context.{utxo-context as s-utxo-context};

    resource utxo {
      new: static func(utxo-context: s-utxo-context) -> utxo;
      trigger: func();
    }

    record storage {
      yield: s32,
      yield1: s32,
      yield1-v1: s32,
    }

    get-storage: func(self: borrow<utxo>) -> storage;

    set-storage: func(ctx: s-utxo-context, storage: storage) -> utxo;
  }
  export starstream:effect-handler/effects;
}
package starstream:std {
  interface builtin {
    resource utxo {
      has-method: func(hash: tuple<u64, u64, u64, u64>) -> bool;
    }

    resource token;

    push-effect-handler-frame: func(frame-id: u32);

    add-effect-handler: func(hash: tuple<u64, u64, u64, u64>);

    pop-effect-handler-frame: func();
  }
  interface utxo-context {
    resource utxo-context {
      resume: func();
      implements-method: func(hash: tuple<u64, u64, u64, u64>);
    }
  }
}


package starstream:contract {
  interface dynamic-utxo {
    use starstream:std/builtin.{utxo as s-utxo};

    trigger: func(self: borrow<s-utxo>);
  }
}


package starstream:effects {
  interface effects {
    hello: func();
  }
}


package starstream:events {
  interface effects {
    log: func(point: u32);
  }
}


package starstream:self {
  interface trigger-utxo {
    resource utxo {
      new: static func() -> utxo;
      trigger: func();
    }
  }
}


package starstream:effect-handler {
  interface effects {
    hello: func(frame-id: u32) -> u8;
  }
}

==== Test: Effect search reaches outer instance handler ====
events: [
    Event {
        abi_name: "effects",
        name: "log",
        params: [
            U32(
                1,
            ),
        ],
    },
]
outputs: [
    Ok(
        UtxoCtx {
            methods: [
                (
                    12924978726027473512,
                    3280860043420341656,
                    8199434769496639849,
                    3465127222637580594,
                ),
            ],
            dropped: false,
        },
    ),
]
