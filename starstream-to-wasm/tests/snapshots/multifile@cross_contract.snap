  interface builtin {
    resource utxo {
      has-method: func(hash: tuple<u64, u64, u64, u64>) -> bool;
    }

    resource token;

    push-effect-handler-frame: func(frame-id: u32);

    add-effect-handler: func(hash: tuple<u64, u64, u64, u64>);

    pop-effect-handler-frame: func();
